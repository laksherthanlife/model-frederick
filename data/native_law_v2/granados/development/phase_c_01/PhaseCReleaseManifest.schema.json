  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GroupId": {
      "enum": [
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep1",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep2",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep3",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep4",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep5"
      ]
    },
    "TrainGroupId": {
      "enum": [
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep1",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep2",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep3"
      ]
    },
    "DevelopmentGroupId": {
      "enum": [
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep4",
        "1b38366b-7473-4ddf-9cf9-26e625533686:/rep5"
      ]
    },
    "ModelId": {
      "enum": [
        "prefix_persistence",
        "training_constant",
        "prefix_offset",
        "prefix_affine_time",
        "first_order_response",
        "transient_response"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "protocol_snapshot",
            "operational_approval",
            "source_binding_audit",
            "training_projection",
            "development_inputs",
            "development_responses",
            "execution_code",
            "model_checkpoint",
            "attempt_log",
            "development_predictions",
            "operational_event_log",
            "development_report"
          ]
        }
      }
    },
    "DevelopmentReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "protocol_id",
        "protocol_sha256",
        "source_asset_id",
        "source_sha256",
        "train_ids",
        "development_ids",
        "exporter_code",
        "executor_code",
        "requested_phases",
        "requester"
      ],
      "properties": {
        "document_type": {
          "const": "development_release_request"
        },
        "protocol_id": {
          "const": "granados-sfp1-published-cohort-development-01"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source_asset_id": {
          "const": "1b38366b-7473-4ddf-9cf9-26e625533686"
        },
        "source_sha256": {
          "const": "1ec5a48955492aade95386d48f15109397a19acb60ef820d3c692ca59d9efc87"
        },
        "train_ids": {
          "const": [
            "1b38366b-7473-4ddf-9cf9-26e625533686:/rep1",
            "1b38366b-7473-4ddf-9cf9-26e625533686:/rep2",
            "1b38366b-7473-4ddf-9cf9-26e625533686:/rep3"
          ]
        },
        "development_ids": {
          "const": [
            "1b38366b-7473-4ddf-9cf9-26e625533686:/rep4",
            "1b38366b-7473-4ddf-9cf9-26e625533686:/rep5"
          ]
        },
        "exporter_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "executor_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "requested_phases": {
          "const": [
            "training_and_conditioning_export",
            "development_response_export"
          ]
        },
        "requester": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DevelopmentCustodyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "protocol_id",
        "request_sha256",
        "decision",
        "custodian_identity",
        "operational_event_reference",
        "reviewed_source_asset_id",
        "reviewed_source_sha256",
        "permitted_group_ids",
        "conditions",
        "limitations",
        "strong_claim_authorized"
      ],
      "properties": {
        "document_type": {
          "const": "development_custody_decision_not_external_attestation"
        },
        "protocol_id": {
          "const": "granados-sfp1-published-cohort-development-01"
        },
        "request_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "decision": {
          "enum": [
            "approve_development_exports",
            "refuse_development_exports"
          ]
        },
        "custodian_identity": {
          "type": "string",
          "minLength": 1
        },
        "operational_event_reference": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_source_asset_id": {
          "const": "1b38366b-7473-4ddf-9cf9-26e625533686"
        },
        "reviewed_source_sha256": {
          "const": "1ec5a48955492aade95386d48f15109397a19acb60ef820d3c692ca59d9efc87"
        },
        "permitted_group_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GroupId"
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strong_claim_authorized": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approve_development_exports"
              }
            }
          },
          "then": {
            "properties": {
              "permitted_group_ids": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          },
          "else": {
            "properties": {
              "permitted_group_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "SourceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "split",
        "window",
        "cell_index",
        "frame_1based",
        "relative_time_min",
        "max5",
        "median",
        "time_pointer",
        "max5_pointer",
        "median_pointer"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/GroupId"
        },
        "split": {
          "enum": [
            "train",
            "development"
          ]
        },
        "window": {
          "enum": [
            "prefix",
            "response"
          ]
        },
        "cell_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_1based": {
          "type": "integer",
          "minimum": 1,
          "maximum": 97
        },
        "relative_time_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max5": {
          "type": [
            "number",
            "null"
          ]
        },
        "median": {
          "type": [
            "number",
            "null"
          ]
        },
        "time_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "max5_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "median_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "window": {
                "const": "prefix"
              }
            }
          },
          "then": {
            "properties": {
              "frame_1based": {
                "minimum": 28,
                "maximum": 47
              }
            }
          },
          "else": {
            "properties": {
              "frame_1based": {
                "minimum": 50,
                "maximum": 73
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "split": {
                "const": "train"
              }
            }
          },
          "then": {
            "properties": {
              "group_id": {
                "$ref": "#/$defs/TrainGroupId"
              }
            }
          },
          "else": {
            "properties": {
              "group_id": {
                "$ref": "#/$defs/DevelopmentGroupId"
              }
            }
          }
        }
      ]
    },
    "SourceTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "cell_index",
        "frame_1based",
        "relative_time_min",
        "time_pointer"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/GroupId"
        },
        "cell_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_1based": {
          "type": "integer",
          "minimum": 50,
          "maximum": 73
        },
        "relative_time_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "time_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "protocol_id",
        "phase",
        "approval_sha256",
        "source_asset_id",
        "source_sha256",
        "group_ids",
        "source_cells",
        "source_times",
        "source_binding_audit"
      ],
      "properties": {
        "document_type": {
          "const": "source_bound_development_projection"
        },
        "protocol_id": {
          "const": "granados-sfp1-published-cohort-development-01"
        },
        "phase": {
          "enum": [
            "training_values",
            "development_inputs",
            "development_responses"
          ]
        },
        "approval_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source_asset_id": {
          "const": "1b38366b-7473-4ddf-9cf9-26e625533686"
        },
        "source_sha256": {
          "const": "1ec5a48955492aade95386d48f15109397a19acb60ef820d3c692ca59d9efc87"
        },
        "group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GroupId"
          }
        },
        "source_cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SourceCell"
          }
        },
        "source_times": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceTime"
          }
        },
        "source_binding_audit": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "training_values"
              }
            }
          },
          "then": {
            "properties": {
              "group_ids": {
                "const": [
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep1",
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep2",
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep3"
                ]
              },
              "source_cells": {
                "minItems": 17292,
                "maxItems": 17292,
                "items": {
                  "properties": {
                    "split": {
                      "const": "train"
                    },
                    "group_id": {
                      "$ref": "#/$defs/TrainGroupId"
                    }
                  }
                }
              },
              "source_times": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "development_inputs"
              }
            }
          },
          "then": {
            "properties": {
              "group_ids": {
                "const": [
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep4",
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep5"
                ]
              },
              "source_cells": {
                "minItems": 7040,
                "maxItems": 7040,
                "items": {
                  "properties": {
                    "split": {
                      "const": "development"
                    },
                    "window": {
                      "const": "prefix"
                    },
                    "group_id": {
                      "$ref": "#/$defs/DevelopmentGroupId"
                    }
                  }
                }
              },
              "source_times": {
                "minItems": 8448,
                "maxItems": 8448,
                "items": {
                  "properties": {
                    "group_id": {
                      "$ref": "#/$defs/DevelopmentGroupId"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "development_responses"
              }
            }
          },
          "then": {
            "properties": {
              "group_ids": {
                "const": [
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep4",
                  "1b38366b-7473-4ddf-9cf9-26e625533686:/rep5"
                ]
              },
              "source_cells": {
                "minItems": 8448,
                "maxItems": 8448,
                "items": {
                  "properties": {
                    "split": {
                      "const": "development"
                    },
                    "window": {
                      "const": "response"
                    },
                    "group_id": {
                      "$ref": "#/$defs/DevelopmentGroupId"
                    }
                  }
                }
              },
              "source_times": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "PrefixSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "origin_1based",
        "eligible_cell_indices",
        "mu",
        "s",
        "input_projection_sha256",
        "operator_id"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/GroupId"
        },
        "origin_1based": {
          "const": 49
        },
        "eligible_cell_indices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mu": {
          "type": "number",
          "minimum": 0
        },
        "s": {
          "type": "number",
          "minimum": 0
        },
        "input_projection_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "operator_id": {
          "const": "complete_prefix_raw_ratio_mean_and_mean_frame_sd_o_minus_21_to_o_minus_2"
        }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "start_index",
        "seed",
        "loss_evaluations",
        "status",
        "parameters",
        "training_mean_mse",
        "checkpoint",
        "reason"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/ModelId"
        },
        "start_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "seed": {
          "enum": [
            201801,
            201802,
            201803,
            201804,
            201805,
            201806,
            201807,
            201808
          ]
        },
        "loss_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "training_mean_mse": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "checkpoint": {
          "oneOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "training_mean_mse": {
                "type": "number",
                "minimum": 0
              },
              "checkpoint": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "training_mean_mse": {
                "type": "null"
              },
              "checkpoint": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "FramePrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "group_id",
        "frame_1based",
        "time_min",
        "quantity",
        "unit",
        "status",
        "mean",
        "reason"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/ModelId"
        },
        "group_id": {
          "$ref": "#/$defs/GroupId"
