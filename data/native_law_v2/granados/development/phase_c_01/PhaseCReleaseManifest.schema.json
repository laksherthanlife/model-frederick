    "protocol_id": {
      "const": "granados-sfp1-published-cohort-development-01"
    },
    "protocol_sha256": {
      "const": "0f53f40699ebd0db6df62f00e0a0e6bfc5b56b374ec84a6e36846a8488e6dad6"
    },
    "phase": {
      "const": "development_response_export"
