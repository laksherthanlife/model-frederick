      }
    },
    "response_data_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/ArtifactRef"
          },
          {
            "properties": {
              "role": {
                "const": "development_responses"
              }
            }
          }
        ]
      }
    },
    "operational_event_reference": {
      "type": "string",
      "minLength": 1
