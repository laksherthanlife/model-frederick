# Where this machine keeps the data `ystwin.paths` will not guess at.
#
# Copy to `.ystwin.env` (untracked) and fill in. `tests/conftest.py` loads it if present
# and never overrides a variable already exported, so CI and one-off runs are unaffected.
#
# WHY THIS IS NOT A DEFAULT IN `paths.py`: a path found by convention makes every result
# computed through it reproducible on one machine only. `audit_reproducibility.py` refuses
# a resolver that reaches outside the checkout by convention, and `audit_claims.py` refuses
# a home directory in tracked source. This file is untracked, so neither is violated -- and
# the numbers stay committed as text under `data/`, which is what a clone actually reads.
#
# Every one of these is OPTIONAL. Absent, the tests that need it skip with a message naming
# the variable; no committed number depends on any of them.

# Gen5 .xpt instrument files (the Experiments directory).
YSTWIN_GEN5_XPT=

# The NewProtocol biosensor workbooks. Parser coverage only -- the numbers are committed
# under data/plates and verified against these value-for-value on export.
YSTWIN_PLATES=

# The iGEM results directory holding the July RAW exports.
YSTWIN_IGEM_RESULTS=

# Bio-Rad Cq exports as the machine wrote them, for the G4 anchor.
YSTWIN_QPCR_RAW=

# `ER&OX-summary.xlsx`, needed only to RE-DERIVE data/crosstalk/*.tsv. The workbook names a
# private individual in its document properties and must never be committed.
YSTWIN_CROSSTALK_WORKBOOK=

# These already resolve inside the checkout and need setting only to point elsewhere:
# YSTWIN_YEAST_GEM= YSTWIN_EC_YEAST_GEM= YSTWIN_THERMO= YSTWIN_QPCR= YSTWIN_ATP_SENSOR=
